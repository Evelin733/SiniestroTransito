library(readxl)
library(dplyr)
library(tsibble)
# 1. Leer el archivo Excel usando ruta relativa (para que funcione con Git)
archivo <- "Data/12. BDD_diciembre_2024_final_SM.xlsx"
df <- read_excel(archivo, sheet = "BDD_2024", col_types = "text")
# 2. Convertir la columna FECHA a formato fecha de R
df$FECHA <- as.Date(df$FECHA, format = "%Y-%m-%d")
# 3. Crear el tsibble indexado por FECHA (sin agrupar previamente)
ts_datos <- df %>%
as_tsibble(index = FECHA)
library(readxl)
library(dplyr)
library(tsibble)
# 1. Leer el archivo Excel usando ruta relativa (para que funcione con Git)
archivo <- "Data/12. BDD_diciembre_2024_final_SM.xlsx"
df <- read_excel(archivo, sheet = "BDD_2024", col_types = "text")
# 2. Convertir la columna FECHA a formato fecha de R
df$FECHA <- as.Date(df$FECHA, format = "%Y-%m-%d")
# 2.1. Limpiar los registros que hayan quedado como NA en la fecha
df <- df %>% filter(!is.na(FECHA))
# 3. Crear el tsibble indexado por FECHA
ts_datos <- df %>%
as_tsibble(index = FECHA)
# 4. Ver el resultado
print(ts_datos)
