library(readxl)
library(dplyr)
library(tsibble)
library(lubridate)
# 1. RUTA RELATIVA (Funciona en la PC de cualquier compañero que clone el Git)
# Asumiendo que dentro de tu repositorio tienes una carpeta llamada "DATOS_ST/Limpieza"
ruta_carpeta <- "DATOS_ST/DATOS_ST/Limpieza"
# O si tu carpeta de limpieza está directamente en la raíz del proyecto:
# ruta_carpeta <- "Limpieza"
# 2. Especificar el archivo único que vas a leer hoy
archivo_individual <- file.path(ruta_carpeta, "08. BDD_Septiembre_2026_SM.xlsx") # Cambia por el nombre real de tu archivo
# 3. Nombre exacto de la hoja
nombre_hoja_exacta <- "BDD_2026" # O "BDD_2024", etc.
# 4. Lectura segura forzando texto
df_individual <- read_excel(archivo_individual, sheet = nombre_hoja_exacta, col_types = "text")
